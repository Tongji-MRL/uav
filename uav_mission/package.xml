<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_mission</name>
  <version>0.0.0</version>
  <description>Single-node RobotX UAV mission state machine for MAP, TASK1, TASK3, and TASK4.</description>

  <maintainer email="robotx@example.invalid">RobotX Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>px4_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>uav_common</exec_depend>
  <exec_depend>uav_map</exec_depend>
  <exec_depend>uav_task1</exec_depend>
  <exec_depend>uav_task3</exec_depend>
  <exec_depend>uav_task4</exec_depend>
  <exec_depend>color_light_detector</exec_depend>
  <exec_depend>robotx_uav_pontoon_bridge</exec_depend>
  <exec_depend>robotx_uav_pontoon_interfaces</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

